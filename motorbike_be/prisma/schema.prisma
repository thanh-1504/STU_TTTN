generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id       Int      @id @default(autoincrement())
  roleName RoleName @unique @map("role_name")
  users    User[]

  @@map("roles")
}

model User {
  id                         Int            @id @default(autoincrement())
  username                   String         @unique @db.VarChar(50)
  password                   String         @db.VarChar(255)
  fullname                   String         @db.VarChar(100)
  phone                      String         @unique @db.VarChar(15)
  email                      String         @unique @db.VarChar(255)
  isActive                   Boolean        @default(true) @map("is_active")
  lastLogin                  DateTime?      @map("last_login")
  createdAt                  DateTime       @default(now()) @map("created_at")
  updatedAt                  DateTime       @updatedAt @map("updated_at")
  roleId                     Int            @map("role_id")
  appointmentsAsTechnician   Appointment[]  @relation("TechnicianAppointments")
  importOrders               ImportOrder[]
  repairOrdersAsReceptionist RepairOrder[]  @relation("ReceptionistOrders")
  repairOrdersAsTechnician   RepairOrder[]  @relation("TechnicianOrders")
  role                       Role           @relation(fields: [roleId], references: [id])
  workSchedules              WorkSchedule[]

  @@map("users")
}

model Customer {
  id            Int            @id @default(autoincrement())
  phone         String         @unique @db.VarChar(15)
  customerName  String         @map("customer_name") @db.VarChar(100)
  address       String?
  totalSpent    Decimal        @default(0) @map("total_spent") @db.Decimal(15, 2)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  email         String?        @unique @db.VarChar(255)
   notificationEmail String?  @map("notification_email") @db.VarChar(255)
  password      String?        @db.VarChar(255)
  avatarUrl     String?        @map("avatar_url") @db.VarChar(500)
  appointments  Appointment[]
  notifications Notification[]
  repairOrders  RepairOrder[]
  reviews       Review[]
  vehicles      Vehicle[]

  @@map("customers")
}

model Vehicle {
  id           Int           @id @default(autoincrement())
  licensePlate String        @unique @map("license_plate") @db.VarChar(20)
  brand        String        @db.VarChar(50)
  vehicleType  VehicleType   @map("vehicle_type")
  model        String?       @db.VarChar(100)
  currentKm    Int?          @map("current_km")
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  customerId   Int           @map("customer_id")
  imageUrl     String?       @default("") @map("image_url") @db.VarChar(500)
  appointments Appointment[]
  repairOrders RepairOrder[]
  customer     Customer      @relation(fields: [customerId], references: [id])

  @@map("vehicles")
}

model Appointment {
  id                   Int                    @id @default(autoincrement())
  appointmentTime      DateTime               @map("appointment_time")
  status               AppointmentStatus      @default(PENDING)
  symptoms             String?
  notes                String?
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  customerId           Int                    @map("customer_id")
  vehicleId            Int?                   @map("vehicle_id")
  technicianId         Int?                   @map("technician_id")
  appointment_services appointment_services[]
  customer             Customer               @relation(fields: [customerId], references: [id])
  technician           User?                  @relation("TechnicianAppointments", fields: [technicianId], references: [id])
  vehicle              Vehicle?               @relation(fields: [vehicleId], references: [id])
  repairOrder          RepairOrder?

  @@map("appointments")
}

model RepairOrder {
  id                   Int                  @id @default(autoincrement())
  status               RepairOrderStatus    @default(RECEIVED)
  symptoms             String?
  vehicleConditionNote String?              @map("vehicle_condition_note")
  totalAmount          Decimal              @default(0) @map("total_amount") @db.Decimal(15, 2)
  paidAmount           Decimal              @default(0) @map("paid_amount") @db.Decimal(15, 2)
  paymentMethod        PaymentMethod?       @map("payment_method")
  warrantyNote         String?              @map("warranty_note")
  technicianNote       String?              @map("technician_note")
  paidAt               DateTime?            @map("paid_at")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  appointmentId        Int?                 @unique @map("appointment_id")
  customerId           Int                  @map("customer_id")
  vehicleId            Int                  @map("vehicle_id")
  receptionistId       Int                  @map("receptionist_id")
  technicianId         Int                  @map("technician_id")
  voucherId            Int?                 @map("voucher_id")
  notifications        Notification[]
  items                RepairOrderItem[]
  services             RepairOrderService[]
  appointment          Appointment?         @relation(fields: [appointmentId], references: [id])
  customer             Customer             @relation(fields: [customerId], references: [id])
  receptionist         User                 @relation("ReceptionistOrders", fields: [receptionistId], references: [id])
  technician           User                 @relation("TechnicianOrders", fields: [technicianId], references: [id])
  vehicle              Vehicle              @relation(fields: [vehicleId], references: [id])
  voucher              Voucher?             @relation(fields: [voucherId], references: [id])

  @@map("repair_orders")
}

model Service {
  id                   Int                    @id @default(autoincrement())
  serviceName          String                 @unique @map("service_name") @db.VarChar(255)
  description          String?
  imageUrl             String?                @map("image_url") @db.VarChar(500)
  durationMinutes      Int                    @map("duration_minutes")
  priceManual          Decimal                @map("price_manual") @db.Decimal(15, 2)
  priceScooter         Decimal                @map("price_scooter") @db.Decimal(15, 2)
  priceMoto            Decimal                @map("price_moto") @db.Decimal(15, 2)
  isActive             Boolean                @default(true) @map("is_active")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  appointment_services appointment_services[]
  comboServices        ComboService[]
  repairOrderServices  RepairOrderService[]

  @@map("services")
}

model Combo {
  id          Int            @id @default(autoincrement())
  comboName   String         @map("combo_name") @db.VarChar(255)
  description String?
  imageUrl    String?        @map("image_url") @db.VarChar(500)
  discountPct Decimal?       @map("discount_pct") @db.Decimal(5, 2)
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  services    ComboService[]

  @@map("combos")
}

model ComboService {
  comboId   Int     @map("combo_id")
  serviceId Int     @map("service_id")
  combo     Combo   @relation(fields: [comboId], references: [id])
  service   Service @relation(fields: [serviceId], references: [id])

  @@id([comboId, serviceId])
  @@map("combo_services")
}

model RepairOrderService {
  id            Int         @id @default(autoincrement())
  appliedPrice  Decimal     @map("applied_price") @db.Decimal(15, 2)
  repairOrderId Int         @map("repair_order_id")
  serviceId     Int         @map("service_id")
  repairOrder   RepairOrder @relation(fields: [repairOrderId], references: [id])
  service       Service     @relation(fields: [serviceId], references: [id])

  @@map("repair_order_services")
}

model SparePart {
  id               Int               @id @default(autoincrement())
  partNumber       String            @unique @map("part_number") @db.VarChar(50)
  partName         String            @map("part_name") @db.VarChar(200)
  unit             String            @default("cái") @db.VarChar(20)
  stockQuantity    Int               @default(0) @map("stock_quantity")
  minStockLevel    Int               @default(5) @map("min_stock_level")
  sellingPrice     Decimal           @map("selling_price") @db.Decimal(15, 2)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  importItems      ImportItem[]
  repairOrderItems RepairOrderItem[]

  @@map("spare_parts")
}

model RepairOrderItem {
  id            Int         @id @default(autoincrement())
  quantity      Int
  unitPrice     Decimal     @map("unit_price") @db.Decimal(15, 2)
  warrantyNote  String?     @map("warranty_note") @db.VarChar(255)
  repairOrderId Int         @map("repair_order_id")
  sparePartId   Int         @map("spare_part_id")
  repairOrder   RepairOrder @relation(fields: [repairOrderId], references: [id])
  sparePart     SparePart   @relation(fields: [sparePartId], references: [id])

  @@map("repair_order_items")
}

model ImportOrder {
  id          Int          @id @default(autoincrement())
  importDate  DateTime     @default(now()) @map("import_date")
  totalAmount Decimal      @map("total_amount") @db.Decimal(15, 2)
  notes       String?
  createdAt   DateTime     @default(now()) @map("created_at")
  adminId     Int          @map("admin_id")
  items       ImportItem[]
  admin       User         @relation(fields: [adminId], references: [id])

  @@map("import_orders")
}

model ImportItem {
  id            Int         @id @default(autoincrement())
  quantity      Int
  importPrice   Decimal     @map("import_price") @db.Decimal(15, 2)
  importOrderId Int         @map("import_order_id")
  sparePartId   Int         @map("spare_part_id")
  importOrder   ImportOrder @relation(fields: [importOrderId], references: [id])
  sparePart     SparePart   @relation(fields: [sparePartId], references: [id])

  @@map("import_items")
}

model Voucher {
  id              Int           @id @default(autoincrement())
  voucherCode     String        @unique @map("voucher_code") @db.VarChar(50)
  description     String?
  discountAmount  Decimal?      @map("discount_amount") @db.Decimal(15, 2)
  discountPercent Int?          @map("discount_percent")
  maxDiscount     Decimal?      @map("max_discount") @db.Decimal(15, 2)
  minOrderValue   Decimal       @default(0) @map("min_order_value") @db.Decimal(15, 2)
  startDate       DateTime      @map("start_date")
  endDate         DateTime      @map("end_date")
  status          VoucherStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  repairOrders    RepairOrder[]

  @@map("vouchers")
}

model BlogPost {
  id           Int           @id @default(autoincrement())
  title        String        @db.VarChar(500)
  slug         String        @unique @db.VarChar(500)
  content      String
  thumbnailUrl String?       @map("thumbnail_url") @db.VarChar(500)
  status       BlogStatus    @default(DRAFT)
  publishedAt  DateTime?     @map("published_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  categoryId   Int?          @map("category_id")
  category     BlogCategory? @relation(fields: [categoryId], references: [id])

  @@map("blog_posts")
}

model BlogCategory {
  id           Int        @id @default(autoincrement())
  categoryName String     @unique @map("category_name") @db.VarChar(100)
  posts        BlogPost[]

  @@map("blog_categories")
}

model Banner {
  id        Int       @id @default(autoincrement())
  title     String?   @db.VarChar(255)
  imageUrl  String    @map("image_url") @db.VarChar(500)
  linkUrl   String?   @map("link_url") @db.VarChar(500)
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("banners")
}

model Review {
  id         Int          @id @default(autoincrement())
  rating     Int
  comment    String?
  status     ReviewStatus @default(PENDING)
  adminReply String?      @map("admin_reply")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  customerId Int          @map("customer_id")
  customer   Customer     @relation(fields: [customerId], references: [id])

  @@map("reviews")
}

model Notification {
  id            Int              @id @default(autoincrement())
  type          NotificationType
  title         String           @db.VarChar(255)
  message       String
  isRead        Boolean          @default(false) @map("is_read")
  sentAt        DateTime?        @map("sent_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  customerId    Int?             @map("customer_id")
  repairOrderId Int?             @map("repair_order_id")
  customer      Customer?        @relation(fields: [customerId], references: [id])
  repairOrder   RepairOrder?     @relation(fields: [repairOrderId], references: [id])

  @@map("notifications")
}

model WorkSchedule {
  id          Int      @id @default(autoincrement())
  workDate    DateTime @map("work_date") @db.Date
  shiftStart  DateTime @map("shift_start")
  shiftEnd    DateTime @map("shift_end")
  maxVehicles Int      @default(10) @map("max_vehicles")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  userId      Int      @map("user_id")
  user        User     @relation(fields: [userId], references: [id])

  @@map("work_schedules")
}

model SystemConfig {
  id          Int      @id @default(autoincrement())
  configKey   String   @unique @map("config_key") @db.VarChar(100)
  configValue String   @map("config_value")
  description String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

model appointment_services {
  appointment_id Int
  service_id     Int
  appointments   Appointment @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
  services       Service     @relation(fields: [service_id], references: [id])

  @@id([appointment_id, service_id])
}

enum RoleName {
  ADMIN
  RECEPTIONIST
  TECHNICIAN
}

enum VehicleType {
  MANUAL
  SCOOTER
  BIG
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum RepairOrderStatus {
  RECEIVED
  IN_PROGRESS
  PENDING
  COMPLETED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  QR_CODE
}

enum VoucherStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum NotificationType {
  APPOINTMENT_CONFIRM
  APPOINTMENT_REMINDER
  REPAIR_COMPLETED
  MAINTENANCE_DUE
  OIL_CHANGE_DUE
  STOCK_ALERT
  PRICE_APPROVAL
}
